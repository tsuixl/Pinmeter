node_modules/
target/
/src/frontend/dist/
/src/frontend/dist-ssr/
/src/backend/host/gen/schemas/
*.tsbuildinfo

# Tool caches and test output
.vite/
.cache/
.eslintcache
.stylelintcache
.npm/
.pnpm-store/
