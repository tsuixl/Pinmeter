{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pinmeter",
  "version": "0.1.3",
  "identifier": "io.pinmeter.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm run dev", "cwd": "../../frontend" },
    "beforeBuildCommand": { "script": "npm run build", "cwd": "../../frontend" },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Pinmeter", "width": 880, "height": 600, "minWidth": 420, "minHeight": 400, "decorations": true, "visible": false, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdDQUE3Q0NEQzZENzY0ODkKUldTSlpOZkd6WHlxZkdCN0w5ZUlWb1ptTys0MGdGWGxPR3J1czAvdjRTL2pCc05Db0M1NEUxSDYK",
      "endpoints": ["https://github.com/tsuixl/Pinmeter/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "license": "AGPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "copyright": "Copyright (C) 2026 Pinmeter contributors",
    "resources": {
      "../../../LICENSE": "licenses/Pinmeter-AGPL-3.0.txt",
      "resources/legal/": "licenses/",
      "../platform/src/ip/third-party/": "licenses/one-ip/",
      "../../frontend/src/shared/ui/sakani/LICENSE": "licenses/Sakani-MIT.txt",
      "../platform/assets/taskbar/Geist.LICENSE": "licenses/Geist-OFL-1.1.txt",
      "../platform/assets/taskbar/NOTICE": "licenses/Geist-NOTICE.txt",
      "../../shared/fonts/harmonyos-sans-sc/LICENSE.txt": "licenses/HarmonyOS-Sans-LICENSE.txt",
      "../../shared/fonts/harmonyos-sans-sc/NOTICE.txt": "licenses/HarmonyOS-Sans-NOTICE.txt",
      "../../frontend/src/features/ip/assets/brands/NOTICE": "licenses/brands-NOTICE.txt"
    },
    "windows": { "nsis": { "installMode": "currentUser", "installerIcon": "icons/icon.ico", "uninstallerIcon": "icons/icon.ico" } }
  }
}
